      "row": "questions[].points[] (one item per point, group = the question; string options; default Yes/No/Talk)",
      "input": {
        "kind": "question", "title": "Checkout", "need": "Decide the checkout.", "why": "Several parts.",
        "questions": [
          {
            "id": "q1", "title": "Layout", "now": ["One page today"],
            "points": [
              { "id": "p1", "text": "Which layout?", "options": ["Compact", { "label": "Detailed", "pros": ["Clear"], "cons": ["Long"] }] },
              { "id": "p2", "text": "Allow guest checkout?" }
            ]
          },
          {
            "id": "q2", "title": "Payment", "variants": [{ "id": "v1", "label": "Card" }, { "id": "v2", "label": "Wallet" }], "variant_label": "Where",
            "points": [{ "id": "p1", "text": "Take cards?", "options": ["Yes", "No"] }]
          }
        ],
        "recommendation": "Start with q1", "recommendation_why": "It blocks the rest."
      },
      "expect": {
        "kind": "question", "artifacts": 0,
        "items": [
          {
            "id": "q1/p1", "question": "Which layout?", "select": "one",
            "options": [{ "id": "o1", "label": "Compact" }, { "id": "o2", "label": "Detailed", "pros": ["Clear"], "cons": ["Long"] }],
            "group": { "id": "q1", "title": "Layout", "now": ["One page today"] }
          },
          {
            "id": "q1/p2", "question": "Allow guest checkout?", "select": "one",
            "options": [{ "id": "o1", "label": "Yes" }, { "id": "o2", "label": "No" }, { "id": "o3", "label": "Talk with the team" }],
            "group": { "id": "q1", "title": "Layout", "now": ["One page today"] }
          },
          {
            "id": "q2/p1", "question": "Take cards?", "select": "one",
            "options": [{ "id": "o1", "label": "Yes" }, { "id": "o2", "label": "No" }],
            "group": { "id": "q2", "title": "Payment", "variants": [{ "id": "v1", "label": "Card" }, { "id": "v2", "label": "Wallet" }], "variant_label": "Where" }
          }
        ],
        "legacy": {
          "kind": "question", "options": [], "select": "one", "max": null,
          "recommendation": "Start with q1", "recommendation_why": "It blocks the rest.", "recommendations": ["Start with q1"],
          "questions": "$input.questions"
        }
      }
    },
