{
  "_about": "Golden cases for protocol/items.ts (WAG-312). Expected values are written by hand from spec 2.3, 2.4 and 2.6, not generated. `row` names the spec 2.3 row. `legacy` is what projectLegacy gives back (the old columns). \"$input.questions\" means the same value as the input.",
  "asks": [
    {
      "name": "question-options",
      "row": "kind question; options + recommendation",
      "input": {
        "kind": "question", "title": "Layout?", "need": "Pick the checkout layout.", "why": "Both work.",
        "options": [{ "id": "a", "label": "Compact", "title": "Compact" }, { "id": "b", "label": "Detailed" }],
        "recommendation": "a", "recommendation_why": "It fits the app."
      },
      "expect": {
        "kind": "question", "artifacts": 0,
        "items": [{
          "id": "main", "select": "one",
          "options": [{ "id": "a", "label": "Compact", "title": "Compact" }, { "id": "b", "label": "Detailed" }],
          "recommendation": "a", "recommendation_why": "It fits the app."
        }],
        "legacy": {
          "kind": "question",
          "options": [{ "id": "a", "label": "Compact", "title": "Compact" }, { "id": "b", "label": "Detailed" }],
          "select": "one", "max": null, "recommendation": "a", "recommendation_why": "It fits the app.",
          "recommendations": ["a"], "questions": []
        }
      }
    },
    {
