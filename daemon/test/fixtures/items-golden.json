          "kind": "question",
          "options": [{ "id": "a", "label": "Cart" }, { "id": "b", "label": "Search" }, { "id": "c", "label": "Profile" }],
          "select": "many", "max": 2, "recommendation": "a", "recommendation_why": "Most used.",
