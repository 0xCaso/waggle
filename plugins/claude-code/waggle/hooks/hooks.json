{
  "modules": ["./register.tsx"],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/waggle-launcher\" mod claude-hook Stop 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/waggle-launcher\" mod claude-hook SessionStart 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
